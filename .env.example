# Copy this file to .env and paste your own key after the equals sign.
# Never share .env or upload it to GitHub or the submission zip.
GOOGLE_API_KEY=

# Sending the login and completion codes by SMS (optional).
# Leave SMS_PROVIDER empty and the codes are shown on screen instead.
# Choose fast2sms or twilio (SMS), or whatsapp or twilio_whatsapp (WhatsApp), then fill in that provider's lines.
SMS_PROVIDER=

# Fast2SMS: the API key from Dev API in the Fast2SMS dashboard,
# and the ID of your OTP template (OTP section of the dashboard).
FAST2SMS_API_KEY=
FAST2SMS_OTP_ID=

# Twilio: from the Twilio console. TWILIO_FROM is your Twilio phone number, for example +15551234567.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# WhatsApp Cloud API (SMS_PROVIDER=whatsapp): from developers.facebook.com > your app > WhatsApp > API Setup.
# WHATSAPP_TEMPLATE is the name of an approved "authentication" message template (its body is {{1}}).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_LANGUAGE=en

# Twilio WhatsApp (SMS_PROVIDER=twilio_whatsapp): uses TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN above.
# For the sandbox, TWILIO_WHATSAPP_FROM is +14155238886 and each phone must first send "join <word>" to it.
TWILIO_WHATSAPP_FROM=

# ---------------------------------------------------------------------------------------------------------
# WhatsApp chat bot (optional). Citizens register, track and confirm complaints by chatting, and reminders and
# escalations are pushed to their WhatsApp. See "WhatsApp" in SOLVATHON.md.
# WHATSAPP_PROVIDER is twilio or meta. (If SMS_PROVIDER is twilio_whatsapp or whatsapp, it is chosen for you.)
WHATSAPP_PROVIDER=
# The public address of this portal, with no slash at the end, for example https://kalaburagi-grievance-tracker.onrender.com
# Twilio signs this address, so set it when the portal is behind a proxy or hosting service.
PUBLIC_URL=
# Meta (WhatsApp Cloud API) also needs a verify token you invent, and the app secret (App settings > Basic):
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Optional: the name of an approved utility template whose body is {{1}}, for updates after the 24-hour window.
WHATSAPP_UPDATE_TEMPLATE=
# Shown on the website's login page as a chat link. Twilio's number is used when this is empty.
WHATSAPP_DISPLAY_NUMBER=
# The text the chat link pre-fills. For the Twilio sandbox, this is its "join <word>" message.
WHATSAPP_JOIN_TEXT=

# Claude (optional): understands free-text WhatsApp messages in English or Kannada and picks the kind and category.
# Without it the bot uses menus and keywords. Messages are sent to Anthropic's API when it is on.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# At most this many Claude calls per day, to cap the cost.
WHATSAPP_AI_DAILY_LIMIT=300
